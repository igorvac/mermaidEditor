{
  "name": "mermaid-studio",
  "productName": "Mermaid Studio",
  "version": "0.1.3",
  "private": true,
  "description": "Editor offline de diagramas Mermaid para macOS",
  "author": "Igor Vaccari <igorvac@gmail.com>",
  "repository": "github:igorvac/mermaidEditor",
  "license": "GPL-3.0-or-later",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@fontsource/ubuntu": "^5.2.8",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "codemirror": "^6.0.2",
    "codemirror-lang-mermaid": "^0.5.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.1",
    "material-symbols": "^0.45.1",
    "mermaid": "^11.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "zustand": "^5.0.14"
  }
}
